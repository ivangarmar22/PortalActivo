# Copia este archivo a .env.local y rellénalo con la salida de `npx supabase status`.
# Para la nube, usa .env.production.local con los valores del proyecto (docs/despliegue.md).
# Solo variables públicas: la clave anon/publishable está pensada para el navegador y
# la seguridad depende de las políticas RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# NUNCA con prefijo VITE_: solo para scripts locales (scripts/create-admin.mjs) y pruebas de integración.
SUPABASE_SERVICE_ROLE_KEY=
